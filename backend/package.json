{
  "name": "globetrotter-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GlobeTrotter REST API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
